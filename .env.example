# Public origin used for canonical, Open Graph, sitemap, and robots URLs.
# Set this to the exact deployed origin before a production build.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to ship ORBIT with no analytics script at all. Must keep the
# NEXT_PUBLIC_ prefix so the value reaches the browser bundle at build time.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
