{
  "name": "orbit-solar-observatory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "node --import tsx scripts/generate-og.ts && node --import tsx scripts/generate-seo.ts && node --import tsx scripts/generate-pwa-assets.ts",
    "build": "vinext build && npm run build:pwa",
    "prebuild:vercel": "node --import tsx scripts/generate-og.ts && node --import tsx scripts/generate-seo.ts && node --import tsx scripts/generate-pwa-assets.ts",
    "build:vercel": "VERCEL=1 vinext build && npm run build:pwa && npm run check:production-artifacts && npm run check:profiles && npm run check:share",
    "check:production-artifacts": "if find dist/client -type f -name '*.map' -print -quit | grep -q .; then echo 'Source maps found in production output'; exit 1; fi; if grep -R -q --include='*.js' --include='*.css' 'sourceMappingURL=' dist/client; then echo 'sourceMappingURL found in production output'; exit 1; fi; echo 'Verified: production output contains no source maps.'",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:profiles": "node --import tsx scripts/check-profile-export.ts",
    "check:share": "node --import tsx scripts/check-share-export.ts",
    "predev": "node --import tsx scripts/generate-pwa-assets.ts",
    "build:pwa": "node --import tsx scripts/build-pwa.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@vercel/analytics": "^2.0.1",
    "astronomy-engine": "2.1.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "i18next": "^26.4.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "geotiff": "2.1.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
